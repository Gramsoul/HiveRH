### HiveRH API smoke test
### Ejecutar en este orden. La API usa JWT en todos los endpoints salvo /api/auth/**.
### Requisitos:
### 1. Aplicacion levantada en localhost:8080
### 2. Base MySQL configurada en .env
### 3. El certificado de prueba vive dentro del repo en testdata/certificate-sample.pdf

@baseUrl = http://localhost:8080
@json = application/json
@user = qa_admin
@email = qa_admin@hiverh.local
@password = ChangeMe123!

### 1. Registrar usuario
POST {{baseUrl}}/api/auth/register
Content-Type: {{json}}

{
  "user": "{{user}}",
  "email": "{{email}}",
  "password": "{{password}}",
  "rol": "ADMIN"
}

### 2. Login y captura de token
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: {{json}}

{
  "identifier": "{{email}}",
  "password": "{{password}}"
}

> {% client.global.set("token", response.body.token); %}

### 3. Crear departamento
# @name createDepartment
POST {{baseUrl}}/api/department
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "name": "Recursos Humanos QA"
}

> {% client.global.set("departmentId", response.body.id_department); %}

### 4. Listar departamentos
GET {{baseUrl}}/api/department?id_department={{departmentId}}
Authorization: Bearer {{token}}

### 5. Crear sucursal
# @name createBranch
POST {{baseUrl}}/api/branch
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "name": "Casa Central QA",
  "city": "Cordoba",
  "address": "Av. Siempre Viva 123"
}

> {% client.global.set("branchId", response.body.id_branch); %}

### 6. Listar sucursales
GET {{baseUrl}}/api/branch
Authorization: Bearer {{token}}

### 7. Crear puesto
# @name createPosition
POST {{baseUrl}}/api/position
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "name": "Analista QA"
}

> {% client.global.set("positionId", response.body.id_position); %}

### 8. Listar puestos
GET {{baseUrl}}/api/position?name=Analista
Authorization: Bearer {{token}}

### 9. Crear empleado
# @name createEmployee
POST {{baseUrl}}/api/employees
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "name": "Ada",
  "lastName": "Lovelace",
  "phoneNumber": "3515550101",
  "genre": "FEMALE",
  "dni": "40111222",
  "city": "Cordoba",
  "address": "Bv. Testing 456",
  "birth_date": "1995-04-12",
  "hire_date": "2026-01-10",
  "base_salary": 1500000,
  "id_branch": {{branchId}},
  "id_position": {{positionId}},
  "id_department": {{departmentId}}
}

> {%
    client.global.set("employeeId", response.body.id_employee);
    client.global.set("employeeDni", response.body.dni);
%}

### 10. Obtener empleado por id
GET {{baseUrl}}/api/employees/{{employeeId}}
Authorization: Bearer {{token}}

### 11. Filtrar empleados
GET {{baseUrl}}/api/employees?fullName=Ada&status=ACTIVE
Authorization: Bearer {{token}}

### 12. Actualizar empleado parcialmente
PATCH {{baseUrl}}/api/employees/{{employeeId}}
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "city": "Villa Carlos Paz",
  "address": "Ruta QA 789",
  "status": "ACTIVE",
  "base_salary": 1650000,
  "id_branch": {{branchId}},
  "id_position": {{positionId}},
  "id_department": {{departmentId}}
}

### Jornada laboral - login como empleado creado
# @name employeeLogin
POST {{baseUrl}}/api/auth/login
Content-Type: {{json}}

{
  "identifier": "{{employeeDni}}",
  "password": "{{employeeDni}}"
}

> {% client.global.set("employeeToken", response.body.token); %}

### Jornada laboral - crear cronograma
# @name createWorkSchedule
POST {{baseUrl}}/api/work-schedules
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "dniEmployee": "{{employeeDni}}",
  "workDate": "2026-08-17",
  "startTime": "08:00:00",
  "endTime": "14:00:00",
  "type": "WORKDAY",
  "note": "Turno manana QA"
}

> {% client.global.set("workScheduleId", response.body.idWorkSchedule); %}

### Jornada laboral - consultar mi cronograma
GET {{baseUrl}}/api/work-schedules/me?from=2026-08-01&to=2026-08-31
Authorization: Bearer {{employeeToken}}

### Jornada laboral - filtrar cronogramas
GET {{baseUrl}}/api/work-schedules?departmentId={{departmentId}}&from=2026-08-01&to=2026-08-31
Authorization: Bearer {{token}}

### Jornada laboral - crear solicitud propia
# @name createWorkRequest
POST {{baseUrl}}/api/work-requests/me
Authorization: Bearer {{employeeToken}}
Content-Type: {{json}}

{
  "requestType": "SHIFT_CHANGE",
  "targetDate": "2026-08-17",
  "startTime": "14:00:00",
  "endTime": "20:00:00",
  "reason": "Cambio de turno por tramite personal",
  "compensationDescription": "Compensa trabajando por la tarde"
}

> {% client.global.set("workRequestId", response.body.idWorkRequest); %}

### Jornada laboral - consultar mis solicitudes
GET {{baseUrl}}/api/work-requests/me?status=PENDING
Authorization: Bearer {{employeeToken}}

### Jornada laboral - aprobar solicitud
PATCH {{baseUrl}}/api/work-requests/{{workRequestId}}/approve
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "reviewComment": "Cambio de turno aprobado para la fecha solicitada"
}

### Jornada laboral - listar solicitudes administrativas
GET {{baseUrl}}/api/work-requests?dniEmployee={{employeeDni}}&status=APPROVED
Authorization: Bearer {{token}}

### 13. Actualizar sucursal
PUT {{baseUrl}}/api/branch/{{branchId}}
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "name": "Casa Central QA",
  "city": "Cordoba Capital",
  "address": "Av. Siempre Viva 123"
}

### 14. Crear periodo de liquidacion
# @name createPayrollPeriod
POST {{baseUrl}}/api/payroll-periods
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "month": 6,
  "year": 2026
}

> {% client.global.set("payrollPeriodId", response.body.idPayrollPeriod); %}

### 15. Crear concepto suma
# @name createAdditionConcept
POST {{baseUrl}}/api/payroll-concepts
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "name": "Bono productividad",
  "description": "Bono mensual QA",
  "type": "ADDITION"
}

> {% client.global.set("additionConceptId", response.body.idPayrollConcept); %}

### 16. Crear concepto descuento
# @name createDeductionConcept
POST {{baseUrl}}/api/payroll-concepts
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "name": "Adelanto",
  "description": "Descuento por adelanto",
  "type": "DEDUCTION"
}

> {% client.global.set("deductionConceptId", response.body.idPayrollConcept); %}

### 17. Listar conceptos
GET {{baseUrl}}/api/payroll-concepts?active=true
Authorization: Bearer {{token}}

### 18. Crear liquidacion en borrador
# @name createPayroll
POST {{baseUrl}}/api/payrolls
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "dniEmployee": "{{employeeDni}}",
  "periodId": {{payrollPeriodId}},
  "details": [
    {
      "payrollConceptId": {{additionConceptId}},
      "amount": 250000,
      "description": "Bono mensual QA"
    },
    {
      "payrollConceptId": {{deductionConceptId}},
      "amount": 50000,
      "description": "Adelanto descontado"
    }
  ]
}

> {% client.global.set("payrollId", response.body.idPayroll); %}

### 19. Confirmar liquidacion
PATCH {{baseUrl}}/api/payrolls/{{payrollId}}/confirm
Authorization: Bearer {{token}}

### 20. Obtener liquidacion
GET {{baseUrl}}/api/payrolls/{{payrollId}}
Authorization: Bearer {{token}}

### 21. Listar liquidaciones por periodo
GET {{baseUrl}}/api/payrolls?periodId={{payrollPeriodId}}
Authorization: Bearer {{token}}

### 22. Listar periodos
GET {{baseUrl}}/api/payroll-periods?year=2026
Authorization: Bearer {{token}}

### 23. Crear vacaciones
# @name createVacation
POST {{baseUrl}}/api/vacations
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "requestDate": "2026-06-11",
  "startDate": "2026-07-01",
  "endDate": "2026-07-10",
  "dniEmployee": "{{employeeDni}}"
}

> {% client.global.set("vacationId", response.body.idVacation); %}

### 22. Listar vacaciones
GET {{baseUrl}}/api/vacations?dniEmployee={{employeeDni}}
Authorization: Bearer {{token}}

### 23. Actualizar vacaciones
PUT {{baseUrl}}/api/vacations/{{vacationId}}
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "requestDate": "2026-06-11",
  "status": "APPROVED",
  "startDate": "2026-07-05",
  "endDate": "2026-07-15",
  "reviewComment": "Vacaciones aprobadas",
  "dniEmployee": "{{employeeDni}}"
}

### 24. Crear licencia
# @name createLicense
POST {{baseUrl}}/api/licenses
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "startDate": "2026-06-20",
  "endDate": "2026-06-22",
  "motive": "Control medico",
  "idCertificates": []
}

> {% client.global.set("licenseId", response.body.id); %}

### 25. Listar licencias
GET {{baseUrl}}/api/licenses
Authorization: Bearer {{token}}

### 26. Obtener licencia por id
GET {{baseUrl}}/api/licenses/{{licenseId}}
Authorization: Bearer {{token}}

### 27. Adjuntar certificado a licencia
### IntelliJ HTTP Client no resuelve variables dentro de `< archivo`, por eso la ruta va literal.
# @name createCertificate
POST {{baseUrl}}/api/certificates
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="idLicense"

{{licenseId}}
--WebAppBoundary
Content-Disposition: form-data; name="description"

Certificado medico
--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="certificate.pdf"
Content-Type: application/pdf

< ./testdata/certificate-sample.pdf
--WebAppBoundary--

> {% client.global.set("certificateId", response.body.idCertificate); %}

### 28. Obtener metadatos de certificado
GET {{baseUrl}}/api/certificate-info?id={{certificateId}}
Authorization: Bearer {{token}}

### 29. Descargar certificado
GET {{baseUrl}}/api/certificate/{{certificateId}}
Authorization: Bearer {{token}}

### 30. Revisar licencia
PATCH {{baseUrl}}/api/licenses/{{licenseId}}
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "status": "APPROVED",
  "isPaid": true,
  "reviewComment": "Licencia aprobada con certificado"
}

### 31. Limpieza opcional: anular liquidacion
PATCH {{baseUrl}}/api/payrolls/{{payrollId}}/cancel
Authorization: Bearer {{token}}

### 32. Limpieza opcional: cerrar periodo
PATCH {{baseUrl}}/api/payroll-periods/{{payrollPeriodId}}/close
Authorization: Bearer {{token}}

### 33. Limpieza opcional: borrar vacaciones
DELETE {{baseUrl}}/api/vacations/{{vacationId}}
Authorization: Bearer {{token}}

### 34. Limpieza opcional: borrar certificado
DELETE {{baseUrl}}/api/certificate/{{certificateId}}
Authorization: Bearer {{token}}

### 35. Limpieza opcional: borrar empleado
DELETE {{baseUrl}}/api/employees/{{employeeDni}}
Authorization: Bearer {{token}}

### 36. Limpieza opcional: borrar puesto
DELETE {{baseUrl}}/api/position/{{positionId}}
Authorization: Bearer {{token}}

### 37. Limpieza opcional: borrar sucursal
DELETE {{baseUrl}}/api/branch/{{branchId}}
Authorization: Bearer {{token}}

### 38. Limpieza opcional: borrar departamento
DELETE {{baseUrl}}/api/department/{{departmentId}}
Authorization: Bearer {{token}}
